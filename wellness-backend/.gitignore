# Ignore Maven / Gradle build folders
/target/
/build/

# Ignore IDE-specific files
/.idea/
/*.iml
/.vscode/
/*.classpath
/*.project
/*.settings/
*.DS_Store

# Ignore logs
/logs/
/*.log

# Ignore environment & credential files
application.properties
application.yml
.env
*.env

# Ignore OS generated files
Thumbs.db

# Ignore node modules if full-stack project
node_modules/
